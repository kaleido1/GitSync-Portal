{
  "name": "gitsync-portal",
  "version": "2.1.5",
  "private": true,
  "description": "Cross-platform GitHub vault synchronization for Obsidian",
  "author": "Kai Liu",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaleido1/GitSync-Portal.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc --noEmit --skipLibCheck",
    "check:release": "node scripts/check-release.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test": "npm run build && npm run check:release && npm run test:sync && npm run test:i18n"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.11.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
