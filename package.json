{
  "name": "obsidian-viewer",
  "version": "1.2.2",
  "private": true,
  "description": "Obsidian Viewer community plugin",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc --noEmit --skipLibCheck",
    "test:sync": "node scripts/test-sync.mjs",
    "test": "npm run build && npm run test:sync"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.11.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
